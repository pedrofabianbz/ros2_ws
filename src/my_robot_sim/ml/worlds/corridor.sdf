<?xml version="1.0"?>
<sdf version="1.8">
  <world name="corridor">
    <!-- Física -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Plugins de sistema (Fortress) -->
    <plugin name="ignition::gazebo::systems::Physics"
            filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands"
            filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster"
            filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Sensors"
            filename="ignition-gazebo-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.90000000000000002</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Ground -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode /></friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
          <plugin name='__default__' filename='__default__' />
        </visual>
      </link>
      <plugin name='__default__' filename='__default__' />
      <pose>0 0 0 0 -0 0</pose>
    </model>

    <!-- Border (caja 20x20) -->
    <model name='border'>
      <pose>0 0 1 0 0 0</pose>
      <static>true</static>

      <link name='wall1'>
        <pose>-10.005 0 0 0 0 0</pose>
        <static>true</static>
        <collision name='wall1_collision'>
          <geometry><box><size>0.01 20 2</size></box></geometry>
        </collision>
        <visual name='wall1_visual'>
          <geometry><box><size>0.01 20 2</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.01 0.05 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>

      <link name='wall2'>
        <pose>10.005 0 0 0 0 0</pose>
        <static>true</static>
        <collision name='wall2_collision'>
          <geometry><box><size>0.01 20 2</size></box></geometry>
        </collision>
        <visual name='wall2_visual'>
          <geometry><box><size>0.01 20 2</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.01 0.05 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>

      <link name='wall3'>
        <pose>0 10.005 0 0 0 0</pose>
        <static>true</static>
        <collision name='wall3_collision'>
          <geometry><box><size>20 0.01 2</size></box></geometry>
        </collision>
        <visual name='wall3_visual'>
          <geometry><box><size>20 0.01 2</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.01 0.05 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>

      <link name='wall4'>
        <pose>0 -10.005 0 0 0 0</pose>
        <static>true</static>
        <collision name='wall4_collision'>
          <geometry><box><size>20 0.01 2</size></box></geometry>
        </collision>
        <visual name='wall4_visual'>
          <geometry><box><size>20 0.01 2</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.01 0.05 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corredor: ancho libre >= 2m (aquí 3.0m) -->
    <!-- Corredor centrado en y=0, con paredes en y=+1.5 y y=-1.5 -->
    <model name='corridor_walls'>
      <pose>0 0 0.5 0 0 0</pose>
      <static>true</static>

      <!-- Parámetros implícitos:
           ancho = 3.0m (distancia entre caras internas)
           largo = 18m (de x=-9 a x=+9 aprox)
           espesor pared = 0.20m
           altura = 1.0m
      -->

      <!-- Pared superior -->
      <link name='wall_top'>
        <!-- centro de pared en y = + (ancho/2 + espesor/2) = 1.5 + 0.1 = 1.6 -->
        <pose>0 1.6 0 0 0 0</pose>
        <static>true</static>
        <collision name='wall_top_collision'>
          <geometry><box><size>18 0.20 1</size></box></geometry>
        </collision>
        <visual name='wall_top_visual'>
          <geometry><box><size>18 0.20 1</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.1 0.2 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>

      <!-- Pared inferior -->
      <link name='wall_bottom'>
        <pose>0 -1.6 0 0 0 0</pose>
        <static>true</static>
        <collision name='wall_bottom_collision'>
          <geometry><box><size>18 0.20 1</size></box></geometry>
        </collision>
        <visual name='wall_bottom_visual'>
          <geometry><box><size>18 0.20 1</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.1 0.2 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>

      <!-- Opcional: “tapones” cortos para que se sienta corredor (deja entradas abiertas) -->
      <!-- Si quieres cerrarlo casi completo, descomenta y ajusta openings -->
      <!--
      <link name='cap_left'>
        <pose>-9.0 0 0 0 0 0</pose>
        <static>true</static>
        <collision name='cap_left_collision'>
          <geometry><box><size>0.20 2.6 1</size></box></geometry>
        </collision>
        <visual name='cap_left_visual'>
          <geometry><box><size>0.20 2.6 1</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.1 0.2 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>

      <link name='cap_right'>
        <pose>9.0 0 0 0 0 0</pose>
        <static>true</static>
        <collision name='cap_right_collision'>
          <geometry><box><size>0.20 2.6 1</size></box></geometry>
        </collision>
        <visual name='cap_right_visual'>
          <geometry><box><size>0.20 2.6 1</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0 0.1 0.2 1</diffuse>
            <specular>0 0.01 0.05 1</specular>
          </material>
        </visual>
      </link>
      -->

    </model>
  </world>
</sdf>
